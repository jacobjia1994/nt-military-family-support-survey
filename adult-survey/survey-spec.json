  "pages": [
    {
      "id": "welcome",
      "title": "Defence Family Support Survey",
      "intro": [
        "Tell us about everyday life and family support in Greater Darwin.",
        "Your experiences will help Lutheran Care plan useful support for serving members and their families."
      ],
      "funding_acknowledgement": "Lutheran Care gratefully acknowledges funding from the Australian Government Department of Defence through the Family Support Funding Program.",
      "questions": [
        {
          "id": "consent",
          "label": "Would you like to take part?",
          "type": "consent",
          "required": true,
          "options": [
            {
              "id": "adult_agree",
              "label": "I am 18 or older and agree to take part. I consent to Lutheran Care collecting and using the information I choose to share, including any health or other sensitive information about me, as described above."
            }
          ]
        }
      ],
      "links": [
        {
          "label": "Lutheran Care Privacy Policy",
          "url": "https://www.lutherancare.org.au/privacy-policy/"
        }
      ],
      "buttons": [
        "Start survey"
      ],
      "source_note": "This questionnaire draws on RAND’s A New Approach for Assessing the Needs of Service Members and Their Families (2011) and the Defence and Veteran Family Wellbeing Strategy 2025–2030.",
      "source_links": [
        {
          "label": "A New Approach for Assessing the Needs of Service Members and Their Families (2011)",
          "url": "https://www.rand.org/content/dam/rand/pubs/monographs/2011/RAND_MG1124.pdf"
        },
        {
          "label": "Defence and Veteran Family Wellbeing Strategy 2025–2030",
          "url": "https://www.defence.gov.au/about/strategic-planning/defence-veteran-family-wellbeing-strategy-2025-2030"
        }
      ],
      "eligibility": {
        "title": "Who can take part",
        "text": "Adults currently serving with the ADF or another country’s military and based in Greater Darwin, and their adult family members. Family members may live elsewhere; this includes partners, former partners, relatives, kin and carers."
      },
      "information_title": "Your information",
      "information_blocks": [
        {
          "title": "Your choice",
          "text": "Taking part is voluntary. You can choose Prefer not to answer where offered, or stop before submitting."
        },
        {
          "title": "How answers are used",
          "text": "Lutheran Care will use your answers to plan its Defence Family Support Program. We may use de-identified survey information in reports and share it with funding partners."
        },
        {
          "title": "Protecting privacy",
          "text": "We do not ask for names or contact details. Please leave out identifying, classified or operationally sensitive information. Unfinished answers stay in this browser and can be resumed for up to 30 days; you can clear them at any time."
        },
        {
          "title": "Privacy and your rights",
          "text": "Our Privacy Policy explains access, correction and complaints. Without identifying details, we may be unable to find your answers later. Information may be disclosed where required or authorised by law."
        }
      ],
      "contact_links": [
        {
          "label": "ntcomms@lutherancare.org.au",
          "url": "mailto:ntcomms@lutherancare.org.au",
          "purpose": "Survey questions"
        },
        {
          "label": "feedback@lutherancare.org.au",
          "url": "mailto:feedback@lutherancare.org.au",
          "purpose": "Privacy concerns"
        }
      ]
    },
    {
      "id": "about",
      "title": "A bit about you",
      "intro": [
        "Please answer each question before continuing."
      ],
      "questions": [
        {
          "id": "role",
          "label": "Which best describes you?",
          "type": "single",
          "required": true,
          "options": [
            {
              "id": "service_member",
              "label": "Currently serving member"
            },
            {
              "id": "partner",
              "label": "Spouse or partner of a currently serving member"
            },
            {
              "id": "both",
              "label": "Both a currently serving member and the spouse or partner of a currently serving member"
            },
            {
              "id": "other_family",
              "label": "Another adult family member, former partner or carer of a currently serving member"
            },
            {
              "id": "prefer_not",
              "label": "Prefer not to answer"
            }
          ],
          "help": "Choose one. “Serving member” includes ADF members and members of another country’s military.",
          "group": "About you"
        },
        {
          "id": "age_group",
          "label": "Which age group are you in?",
          "type": "single",
          "required": true,
          "options": [
            {
              "id": "18_29",
              "label": "18–29"
            },
            {
              "id": "30_39",
              "label": "30–39"
            },
            {
              "id": "40_49",
              "label": "40–49"
            },
            {
              "id": "50_plus",
              "label": "50 or older"
            },
            {
              "id": "prefer_not",
              "label": "Prefer not to answer"
            }
          ],
          "group": "About you"
        },
        {
          "id": "current_connection",
          "label": "Are you or a member of your family currently serving and based in Greater Darwin?",
          "type": "single",
          "required": true,
          "options": [
            {
              "id": "yes",
              "label": "Yes"
            },
            {
              "id": "no",
              "label": "No"
            },
            {
              "id": "unsure",
              "label": "Not sure"
            },
            {
              "id": "prefer_not",
              "label": "Prefer not to answer"
            }
          ],
          "help": "Answer Yes if you or your serving family member is based in Greater Darwin, even if you live elsewhere or the serving member is temporarily away for work.",
          "group": "About you"
        },
        {
          "id": "residence_area",
          "label": "Where do you currently live?",
          "type": "single",
          "required": true,
          "options": [
            {
              "id": "darwin",
              "label": "Darwin"
            },
            {
              "id": "palmerston",
              "label": "Palmerston"
            },
            {
              "id": "litchfield",
              "label": "Litchfield"
            },
            {
              "id": "greater_darwin_other",
              "label": "Other Greater Darwin area"
            },
            {
              "id": "outside",
              "label": "Outside Greater Darwin"
            },
            {
              "id": "prefer_not",
              "label": "Prefer not to answer"
            }
          ],
          "group": "Where you live",
          "primary_option_ids": [
            "darwin",
            "palmerston",
            "litchfield"
          ],
          "secondary_option_ids": [
            "greater_darwin_other",
            "outside"
          ],
          "disclosure_label": "Other area"
        },
        {
          "id": "suburb",
          "label": "Which suburb or locality do you live in?",
          "type": "locality_select",
          "required": true,
          "help": "Choose from the list for your area.",
          "options_ref": "geography.localities filtered by residence_area + geography.extra_locality_options",
          "show_when": "residence_area is a local area",
          "group": "Where you live"
        },
        {
          "id": "suburb_other",
          "label": "Which other suburb or locality?",
          "type": "text",
          "required": true,
          "help": "Please provide only the suburb or locality, not a street address.",
          "show_when": "suburb == other",
          "max_length": 5000,
          "group": "Where you live"
        },
        {
          "id": "nt_duration",
          "label": "How long have you lived in the NT?",
          "type": "integer_group",
          "required": true,
          "help": "Count your current or most recent stay.",
          "fields": [
            {
              "id": "years",
              "path": "nt_duration.years",
              "label": "Years",
              "min": 0,
              "max": 99,
              "required": true
            },
            {
              "id": "months",
              "path": "nt_duration.months",
              "label": "Months",
              "min": 0,
              "max": 11,
              "required": true
            }
          ],
          "group": "Where you live",
          "refusal_path": "nt_duration.prefer_not",
          "refusal_label": "Prefer not to answer"
        },
        {
          "id": "has_dependants",
          "label": "Do you have any dependants?",
          "type": "single",
          "required": true,
          "group": "Your dependants",
          "help": "Include children or adults who rely on you for care or financial support.",
          "options": [
            {
              "id": "yes",
              "label": "Yes"
            },
            {
              "id": "no",
              "label": "No"
            },
            {
              "id": "prefer_not",
              "label": "Prefer not to answer"
            }
          ]
        },
        {
          "id": "dependants_count",
          "label": "How many dependants do you have?",
          "type": "integer_group",
          "required": true,
          "help": "Count each person once.",
          "fields": [
            {
              "id": "total",
              "path": "dependants.total",
              "label": "Total number of dependants",
              "min": 0,
              "max": 9007199254740991,
              "required": true
            },
            {
              "id": "living_with",
              "path": "dependants.living_with",
              "label": "Number who live with you",
              "min": 0,
              "max": 9007199254740991,
              "required": true
            }
          ],
          "show_when": "has_dependants == yes",
          "group": "Your dependants",
          "refusal_path": "dependants.prefer_not",
          "refusal_label": "Prefer not to answer"
        }
      ],
      "buttons": [
        "Back",
        "Continue"
      ]
    },
    {
      "id": "experience",
      "title": "Your living experiences",
      "intro": [
        "Please answer each question. Share as much or as little as you feel comfortable sharing."
      ],
      "questions": [
        {
          "id": "difficulties",
          "label": "What was difficult for you or your family in the Great Darwin Region in the past 12 months?",
          "help": "Tell us what happened and how it affected everyday life.",
          "privacy_hint": "Please leave out details that could identify you or anyone else, such as names, addresses, contact details or service numbers.",
          "type": "text",
          "required": true,
          "max_length": 5000,
          "rows": 8
        },
        {
          "id": "help_needed",
          "label": "What help, if any, did you or your family need to deal with these difficulties?",
          "help": "Include help you received as well as help you needed but could not get. You do not need to know which service could provide it.",
          "privacy_hint": "Please leave out details that could identify you or anyone else, such as names, addresses, contact details or service numbers.",
          "type": "text",
          "required": true,
          "max_length": 5000,
          "rows": 8
        },
        {

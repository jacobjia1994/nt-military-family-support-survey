  "pages": [
    {
      "id": "welcome",
      "title": "Defence Family Support Survey",
      "intro": [
        "Hello Defense Communities,",
        "Have your say and help shape a stronger Defence community in Greater Darwin.",
        "Tell us what has been difficult, what has helped and what support is still missing for you or your family."
      ],
      "funding_acknowledgement": "Lutheran Care gratefully acknowledges funding from the Australian Government Department of Defence through the Family Support Funding Program.",
      "sections": [
        {
          "title": "Who can take part",
          "text": "People aged 18 or older who are currently serving in the Australian Defence Force (ADF) or another country’s military and are based in Greater Darwin, and their adult family members. Family members may live elsewhere. Family includes partners, former partners, parents, adult children, other relatives, kin and carers."
        },
        {
          "title": "Taking part",
          "text": "Taking part is voluntary. After a few background questions, you can share your experiences in your own words. All questions are optional. You can skip questions, go back to change answers or stop before submitting. Share only what you feel comfortable sharing."
        },
        {
          "title": "Your information",
          "text": "Lutheran Care will use the information you choose to share to understand local needs and plan family support. Please leave out names, addresses, contact details, service numbers and other details that could identify you or someone else. Do not include classified or operationally sensitive information."
        },
        {
          "title": "Your privacy",
          "text": "Lutheran Care handles personal information under its Confidentiality and Privacy Policy. Information may be shared where required or authorised by law. The policy explains how to request access to or correction of your personal information, and how to make a privacy complaint."
        }
      ],
      "questions": [
        {
          "id": "consent",
          "label": "Would you like to take part?",
          "type": "consent",
          "required": true,
          "options": [
            {
              "id": "adult_agree",
              "label": "I am aged 18 or older. I have read the information above and agree to take part and to Lutheran Care using the information I choose to share for the purposes explained above."
            }
          ]
        }
      ],
      "links": [
        {
          "label": "Lutheran Care Privacy Policy",
          "url": "https://www.lutherancare.org.au/privacy-policy/"
        },
        {
          "label": "Contact Lutheran Care",
          "url": "mailto:feedback@lutherancare.org.au"
        }
      ],
      "buttons": [
        "Start survey",
        "Leave survey"
      ],
      "contact_note": "For questions or privacy concerns, email feedback@lutherancare.org.au and mention the Defence Family Support Program. This survey is not an application for a service or activity.",
      "source_note": "This questionnaire draws on RAND’s A New Approach for Assessing the Needs of Service Members and Their Families (2011) and the Defence and Veteran Family Wellbeing Strategy 2025–2030."
    },
    {
      "id": "about",
      "title": "A bit about you",
      "intro": [
        "These questions help us understand the different experiences of people taking part. You can leave any question unanswered."
      ],
